# Environment Variables for Bali Pool Pros

# Database Configuration
# PostgreSQL connection string for production
DATABASE_URL=postgresql://user:password@host:5432/database

# Application Environment
# Set to 'production' for Vercel deployment
NODE_ENV=production

# Session Configuration
# Generate a secure random string for session management
# Use: openssl rand -base64 32
SESSION_SECRET=your-secure-session-secret-here

# Optional: Replit Configuration (only for development on Replit)
# REPL_ID=your-repl-id-here
# REPL_OWNER=your-username-here
